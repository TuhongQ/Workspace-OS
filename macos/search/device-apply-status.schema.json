{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-os.local/schema/device-apply-status.schema.json",
  "title": "Workspace OS Device Handoff Apply Status",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "mode",
    "source_device",
    "target_device",
    "copied_files",
    "copied_bytes",
    "overwritten_files",
    "deleted_files",
    "recovered_transactions",
    "issues"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": ["planned", "verified", "already-synced", "blocked", "failed"]
    },
    "mode": { "enum": ["dry-run", "apply"] },
    "source_device": { "type": "string", "minLength": 1 },
    "target_device": { "type": "string", "minLength": 1 },
    "source_inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_inventory_before_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "copied_files": { "type": "integer", "minimum": 0 },
    "copied_bytes": { "type": "integer", "minimum": 0 },
    "overwritten_files": { "const": 0 },
    "deleted_files": { "const": 0 },
    "recovered_transactions": { "type": "integer", "minimum": 0 },
    "comparison": { "type": ["object", "null"] },
    "receipt": { "type": ["object", "null"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "path": { "type": "string" },
          "transaction": { "type": "string" },
          "error": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
