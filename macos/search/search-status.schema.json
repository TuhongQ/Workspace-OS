{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-os.local/schema/search-status.schema.json",
  "title": "Workspace OS Search Maintenance Status",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "database",
    "last_good_database",
    "status",
    "available",
    "current_valid",
    "last_good_valid",
    "using_fallback",
    "action",
    "total_files",
    "content_files",
    "content_hash_verified_files",
    "content_drift_detected",
    "link_entries_skipped",
    "current_issues",
    "last_good_issues",
    "maintenance_issues"
  ],
  "properties": {
    "schema_version": { "const": "1.2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "database": { "type": "string", "minLength": 1 },
    "last_good_database": { "type": "string", "minLength": 1 },
    "status": { "enum": ["healthy", "degraded", "unavailable"] },
    "available": { "type": "boolean" },
    "current_valid": { "type": "boolean" },
    "last_good_valid": { "type": "boolean" },
    "using_fallback": { "type": "boolean" },
    "action": { "enum": ["incremental-promoted", "rebuilt", "kept-existing"] },
    "privacy_mode": { "type": ["string", "null"] },
    "total_files": { "type": "integer", "minimum": 0 },
    "content_files": { "type": "integer", "minimum": 0 },
    "content_hash_verified_files": { "type": "integer", "minimum": 0 },
    "content_drift_detected": { "type": "integer", "minimum": 0 },
    "link_entries_skipped": { "type": "integer", "minimum": 0 },
    "integrity_checked_at": { "type": "string", "format": "date-time" },
    "build": { "type": ["object", "null"] },
    "current_issues": { "type": "array" },
    "last_good_issues": { "type": "array" },
    "maintenance_issues": { "type": "array" },
    "previous_current_valid": { "type": "boolean" },
    "previous_last_good_valid": { "type": "boolean" }
  },
  "additionalProperties": true
}
