{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-os.local/schema/device-bundle-import.schema.json",
  "title": "Workspace OS Offline Device Bundle Import Status",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "mode",
    "archive",
    "target_workspace",
    "target_device",
    "overwritten_files",
    "deleted_files",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["planned", "verified", "already-synced", "blocked", "failed"] },
    "mode": { "enum": ["dry-run", "apply"] },
    "archive": { "type": "string", "minLength": 1 },
    "target_workspace": { "type": "string", "minLength": 1 },
    "target_device": { "type": "string", "minLength": 1 },
    "overwritten_files": { "const": 0 },
    "deleted_files": { "const": 0 },
    "copied_files": { "type": "integer", "minimum": 0 },
    "copied_bytes": { "type": "integer", "minimum": 0 },
    "recovered_transactions": { "type": "integer", "minimum": 0 },
    "verification": {
      "type": "object",
      "required": ["valid", "issues"],
      "properties": {
        "valid": { "type": "boolean" },
        "issues": { "type": "array" }
      },
      "additionalProperties": true
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "type": "string", "minLength": 1 } },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
