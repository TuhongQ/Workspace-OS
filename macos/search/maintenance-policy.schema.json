{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-os.local/schema/maintenance-policy.schema.json",
  "title": "Workspace OS Maintenance Policy",
  "type": "object",
  "required": ["schema_version", "task_prefix", "principal", "settings", "tasks"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_prefix": { "type": "string", "minLength": 1 },
    "principal": {
      "type": "object",
      "required": ["user", "logon_type", "run_level"],
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "logon_type": { "const": "Interactive" },
        "run_level": { "const": "Limited" }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "required": ["execution_time_limit", "start_when_available"],
      "properties": {
        "execution_time_limit": { "type": "string", "minLength": 1 },
        "start_when_available": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "script", "arguments", "trigger"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "script": { "type": "string", "minLength": 1 },
          "arguments": { "type": "array", "items": { "type": "string" } },
          "trigger": {
            "type": "object",
            "required": ["type", "time", "interval"],
            "properties": {
              "type": { "enum": ["daily", "weekly"] },
              "time": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              "interval": { "type": "integer", "minimum": 1 },
              "days_of_week": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
